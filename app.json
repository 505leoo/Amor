{
  "expo": {
    "name": "Amor",
    "slug": "Amor",
    "version": "1.1.0",
    "orientation": "landscape",
    "icon": "./assets/16.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#000000",
      "icon": ""
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1c2f3fe2-d0a3-4fb9-bcc8-be09be0577ec"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "fonts": [
      "./fonts/Omori.ttf",
      "./fonts/Globo.ttf",
      "./fonts/Titulos.ttf"
    ],
    "newArchEnabled": true,
    "android": {
      "package": "com.leitof7.amor",
      "screenOrientation": "landscape",
      "googleServicesFile": "./google-services.json",
      "navigationBar": {
        "visible": "immersive"
      },
      "buildToolsVersion": "35.0.0",
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "architectures": [
        "arm64-v8a"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "scheme": "amor",
    "ios": {
      "requireFullScreen": true,
      "bundleIdentifier": "com.leitof7.amor",
      "supportsTablet": false
    },
    "notification": {
      "icon": "./assets/notifications.png",
      "color": "#FFFFFF",
      "androidMode": "default",
      "androidCollapsedTitle": "Amor"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notifications.png",
          "color": "#FFFFFF",
          "defaultChannel": "amor-notifications"
        }
      ],
      "expo-navigation-bar",
      "expo-audio",
      "expo-image",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tu galería para subir videos."
        }
      ]
    ],
    "runtimeVersion": "0.2",
    "extra": {
      "eas": {
        "projectId": "1c2f3fe2-d0a3-4fb9-bcc8-be09be0577ec"
      },
      "expo-navigation-bar": {},
      "updateVersion": "1.1.0"
    },
    "owner": "leitof7"
  }
}
